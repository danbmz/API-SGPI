### pedidos.http

@baseUrl = http://localhost:3000

### Login como admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usuario": "admin01",
  "password": "admin123"
}

### Listar pedidos — vacío al inicio
GET {{baseUrl}}/pedidos

### Listar ordens 
GET {{baseUrl}}/ordenes

### Listar productos (cualquier usuario autenticado) — debería venir vacío al inicio
GET {{baseUrl}}/productos

### Listar Pigmentos
GET {{baseUrl}}/pigmentos

### Crear pedido
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "numeroPedido": "PED-2026-004",
  "cliente": "Comercializadora del Valle",
  "descripcion": "Pedido de jarras y tapas para entrega en octubre"
}

### Intentar crear con el mismo número — debe fallar con 409
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "numeroPedido": "PED-2026-001",
  "cliente": "Otro cliente"
}

### Ver el pedido creado (reemplaza el id real)
GET {{baseUrl}}/pedidos/4

### Agregar línea de detalle — Jarra 2L Roja (ajusta productoId y pigmentoId)
POST {{baseUrl}}/pedidos/4/detalle
Content-Type: application/json

{
  "productoId": "1",
  "pigmentoId": "1",
  "cantidadSolicitada": 1500
}

### Agregar línea de detalle — sin pigmento específico (ajusta productoId)
POST {{baseUrl}}/pedidos/4/detalle
Content-Type: application/json

{
  "productoId": "4",
  "cantidadSolicitada": 5000
}

### Ver el pedido con su detalle completo
GET {{baseUrl}}/pedidos/1

### Editar pedido (cambiar cliente/descripción)
PATCH {{baseUrl}}/pedidos/3
Content-Type: application/json

{
  "descripcion": "Pedido actualizado: incluye jarras rojas y sin color"
}

### Agregar detalle con producto inexistente — debe fallar con 404
POST {{baseUrl}}/pedidos/3/detalle
Content-Type: application/json

{
  "productoId": "4",
  "pigmentoId": "100",
  "cantidadSolicitada": 1500
}

### Crear una orden ligada a este pedido (ajusta los IDs reales)
POST {{baseUrl}}/ordenes
Content-Type: application/json

{
  "tipoMaterial": "VIRGEN",
  "folio": "OP-2026-PED-01",
  "pedidoDetalleId": "",
  "productoId": "1",
  "materiaPrimaId": "1",
  "pigmentoId": "1",
  "maquinaId": "1",
  "totalPiezas": 500,
  "pedidoId": "3"
}

### Ver el pedido — debe reflejar la orden asociada y el progreso de la línea
GET {{baseUrl}}/pedidos/2

### Crear una orden con virgen 100%
POST {{baseUrl}}/ordenes
Content-Type: application/json

{
  "tipoMaterial": "VIRGEN",
  "folio": "OP-2026-PED-10",
  "pedidoDetalleId": "10",
  "productoId": "4",
  "materiaPrimaId": "1",
  "pigmentoId": "5",
  "maquinaId": "4",
  "totalPiezas": 5000,
  "observaciones": "Orden con piezas de mas considerando merma"
}

### Crear un pedido con MEZCLA - debe dar error por el pigmento y molido no coinciden
POST {{baseUrl}}/ordenes
Content-Type: application/json

{
  "tipoMaterial": "MEZCLA_MOLIDO_INTERNO",
  "folio": "OP-2026-PED-08",
  "pedidoDetalleId": "9",
  "productoId": "2",
  "materiaPrimaId": "4",
  "pigmentoId": "6",
  "maquinaId": "3",
  "totalPiezas": 1000,
  "inventarioMolidoId": "3",
  "porcentajeVirgen": 30,
  "porcentajeMolido": 70,
  "aditivoDescripcion": "Con aditivo",
  "observaciones": "Orden con piezas de mas considerando merma"
}

### Intentar cancelar el pedido (tiene una orden ACTIVA/BORRADOR, aún no en progreso — debería funcionar)
PATCH {{baseUrl}}/pedidos/2/cancelar
Content-Type: application/json

{
  "motivo": "Cliente canceló el pedido completo"
}

### Verificar que el pedido quedó cancelado
GET {{baseUrl}}/pedidos/2

### Intentar editar un pedido ya cancelado — debe fallar con 409
PATCH {{baseUrl}}/pedidos/2
Content-Type: application/json

{
  "descripcion": "No debería poder editarse"
}

### Intentar agregar detalle a un pedido cancelado — debe fallar con 409
POST {{baseUrl}}/pedidos/2/detalle
Content-Type: application/json

{
  "productoId": "1",
  "cantidadSolicitada": 50
}

### ============ PRUEBA DE ROL ============

### Login como supervisor
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usuario": "supervisor01",
  "password": "nuevaPassword456"
}

### Supervisor NO puede ver pedidos — debe fallar con 403
GET {{baseUrl}}/pedidos

### Volver a loguear como admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usuario": "admin01",
  "password": "admin123"
}