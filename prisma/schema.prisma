// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// -------------------- ESQUEMAS / USUARIO

enum RolUsuario {
  ADMIN
  SUPERVISOR
  MOLINO
  PIGMENTOS
  PROGRAMADOR
}

model Usuario {
  id         BigInt     @id @default(autoincrement())

  nombre     String
  usuario    String     @unique   // nombre de login, ej. "admin01"
  password   String                // hash, nunca texto plano
  role       RolUsuario

  activo     Boolean    @default(true)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relaciones inversas (se irán llenando conforme definamos las demás tablas)
  auditLogs AuditLog[]
  ordenesCreadas OrdenProduccion[] @relation("OrdenCreadaPor")
  avancesComoSupervisor        AvanceTurno[]       @relation("AvanceTurnoSupervisor")
  sobrantesConfirmados         AvanceTurno[]       @relation("SobranteConfirmadoPor")
  confirmacionesMolino         AvanceTurno[]       @relation("ConfirmacionMolino")
  solicitudesMaterialConfirmadas SolicitudMaterial[] @relation("SolicitudMaterialConfirmadoPor")
  incidenciasConfirmadasMolino IncidenciaMaterialMalPigmentado[] @relation("IncidenciaConfirmadaMolino")
  incidenciasResueltas         IncidenciaMaterialMalPigmentado[] @relation("IncidenciaResueltaPor")
  refreshTokens RefreshToken[] @relation("RefreshTokensUsuario")
  historialInventario  HistorialMovimientoInventario[]

  @@map("usuarios")
}

// -------------------- AUDITLOGS

enum ModuloAuditoria {
  AUTH
  USUARIOS
  INVENTARIO
  ORDENES
  MOLINO
  CATALOGOS
  PIGMENTOS
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())

  usuarioId      BigInt
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // Snapshot al momento de la acción — no cambia si el usuario se renombra después
  usuarioLogin   String
  usuarioNombre  String

  modulo         ModuloAuditoria
  accion         String

  // Genérico, sin FK real — audit_logs cubre cualquier tabla del sistema
  entidad        String?
  entidadId      BigInt?

  detalle        String?
  ip             String?

  createdAt      DateTime @default(now())

  @@index([usuarioId])
  @@index([modulo])
  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("audit_logs")
}


// -------------------- CATALOGOS E INVENTARIO / MATERIA PRIMA

enum TipoMaterial {
  POLIPROPILENO
  POLIESTIRENO
  POLIETILENO
}

enum UnidadMedida {
  KILOGRAMO
  GRAMO
  LITRO
  MILILITRO
  PIEZA
}

model MateriaPrima {
  id             BigInt       @id @default(autoincrement())

  nombre         String
  codigoInterno  String       @unique
  tipo           TipoMaterial

  proveedor      String?
  unidadMedida   UnidadMedida
  costoUnitario  Decimal?     @db.Decimal(10,2)

  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventarioVirgen  InventarioMateriaPrima?
  ordenesProduccion OrdenProduccion[] @relation("OrdenMateriaPrimaVirgen")
  materialPigmentado  CombinacionMaterialPigmentado[]
  movimientosVirgen HistorialMovimientoInventario[] @relation("MovimientoMateriaPrimaVirgen")

  @@map("materias_primas")
}

model InventarioMateriaPrima {
  id             BigInt       @id @default(autoincrement())

  materiaPrimaId BigInt       @unique
  materiaPrima   MateriaPrima @relation(fields: [materiaPrimaId], references: [id])

  cantidadActual Decimal      @db.Decimal(10,3)
  stockMinimo    Decimal      @db.Decimal(10,3) @default(0)

  updatedAt      DateTime     @updatedAt

  @@map("inventario_materias_primas")
}

// ----------------------------------- CATALOGO DE COLORES SOLIDOS (para moliendas)

model ColorSolido {
  id        BigInt   @id @default(autoincrement())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventariosMolido InventarioMolido[]                @relation("InventarioMolidoColor")
  movimientos       HistorialMovimientoInventario[]   @relation("MovimientoColorSolido")
  moliendas         Molienda[]                        @relation("MoliendaColor")
  pigmentos          Pigmento[]                        @relation("PigmentoColorSolido")

  @@map("colores_solidos")
}

// ---------------------------------- INVENTARIO / MOLIDO

enum OrigenMolido {
  INTERNO
  COMPRADO
}

model InventarioMolido {
  id             BigInt       @id @default(autoincrement())

  tipoMaterial   TipoMaterial

  origen         OrigenMolido
  colorSolidoId  BigInt
  colorSolido    ColorSolido @relation("InventarioMolidoColor", fields: [colorSolidoId], references: [id])

  cantidadActual Decimal      @db.Decimal(10,3)

  updatedAt      DateTime     @updatedAt

  ordenesProduccion OrdenProduccion[]

  @@unique([tipoMaterial, origen, colorSolidoId])
  @@map("inventario_molido")
}

model TipoMolido {
  id            BigInt        @id @default(autoincrement())

  tipoMaterial  TipoMaterial
  origen        OrigenMolido
  codigoInterno String        @unique

  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())

  @@unique([tipoMaterial, origen])
  @@map("tipos_molido")
}

// ---------------------------------- CATALOGOS E INVENTARIO / PIGMENTOS

enum CategoriaColorPigmento {
  SOLIDO
  SOLIDO_PASTEL
  NEON_TRASLUCIDO
  JARRA_NEON_PASTEL
  NATURAL
}

enum TipoPigmento {
  MASTER
  POLVO
}

model Pigmento {
  id              BigInt                 @id @default(autoincrement())

  color           String
  categoriaColor  CategoriaColorPigmento
  tipo            TipoPigmento

  dosisGrPorKg    Decimal                @db.Decimal(10,3)
  costoUnitario   Decimal?               @db.Decimal(10,2)

  tipoMaterial    TipoMaterial           // ← antes: materiaPrimaId BigInt + relación
  colorSolidoId   BigInt?
  colorSolido     ColorSolido? @relation("PigmentoColorSolido", fields: [colorSolidoId], references: [id])

  activo          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  inventario      InventarioPigmento?
  inventarioProducto  InventarioProductoTerminado[]
  pedidoDetalle   PedidoDetalle[]          
  ordenesProduccion OrdenProduccion[]
  materialPigmentado  CombinacionMaterialPigmentado[]
  movimientosInventario HistorialMovimientoInventario[]
  movimientosProducto HistorialMovimientoInventario[] @relation("MovimientoColorProducto")

  @@unique([tipoMaterial, color, categoriaColor, tipo])
  @@map("pigmentos")
}

model InventarioPigmento {
  id             BigInt   @id @default(autoincrement())

  pigmentoId     BigInt   @unique
  pigmento       Pigmento @relation(fields: [pigmentoId], references: [id])

  cantidadActual Decimal  @db.Decimal(10,3)
  stockMinimo    Decimal  @db.Decimal(10,3) @default(0)

  updatedAt      DateTime @updatedAt

  @@map("inventario_pigmentos")
}

// --------------------------------- INVENTARIO / MATERIA PRIMA PIGMENTADA

model CombinacionMaterialPigmentado {
  id             BigInt       @id @default(autoincrement())

  materiaPrimaId     BigInt
  materiaPrima       MateriaPrima     @relation(fields: [materiaPrimaId], references: [id])

  pigmentoId     BigInt
  pigmento       Pigmento     @relation(fields: [pigmentoId], references: [id])

  createdAt      DateTime     @default(now())

  inventario     InventarioMaterialPigmentado?
  movimientosMaterialPigmentado  HistorialMovimientoInventario[]
  ordenesQueLoUsaron OrdenProduccion[] @relation("OrdenMaterialPigmentadoUsado")

  @@unique([materiaPrimaId, pigmentoId])
  @@map("combinaciones_material_pigmentado")
}

model InventarioMaterialPigmentado {
  id                BigInt   @id @default(autoincrement())

  combinacionId     BigInt   @unique
  combinacion       CombinacionMaterialPigmentado @relation(fields: [combinacionId], references: [id])

  cantidadActual    Decimal  @db.Decimal(10,3)
  updatedAt         DateTime @updatedAt

  @@map("inventario_material_pigmentado")
}

// ----------------------------------- CATALOGOS E INVENTARIO / PRODUCTOS

model Producto {
  id             BigInt       @id @default(autoincrement())

  nombre         String
  codigo         String       @unique
  tipo           String

  tipoMaterial        TipoMaterial

  piezasPorEmpaque    Int
  descripcion         String    

  cavidades      Int
  ciclo          Int          // segundos
  peso           Decimal      @db.Decimal(10,2) // gramos
  precio         Decimal      @db.Decimal(10,2) // precio

  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventarios     InventarioProductoTerminado[]
  ordenesProduccion OrdenProduccion[]
  pedidoDetalle   PedidoDetalle[]          
  movimientosInventario HistorialMovimientoInventario[]

  @@map("productos")
}

model InventarioProductoTerminado {
  id             BigInt   @id @default(autoincrement())

  productoId     BigInt
  producto       Producto @relation(fields: [productoId], references: [id])

  pigmentoId     BigInt
  pigmento       Pigmento @relation(fields: [pigmentoId], references: [id])

  cantidadActual Decimal  @db.Decimal(10,3)

  updatedAt      DateTime @updatedAt

  @@unique([productoId, pigmentoId])
  @@map("inventario_producto_terminado")
}

// ------------------------------------ CATALOGOS DE MAQUINAS

enum TipoProcesoMaquina {
  INYECCION
}

enum EstadoMaquina {
  ACTIVA
  INACTIVA
  MANTENIMIENTO
}

model Maquina {
  id            BigInt             @id @default(autoincrement())

  nombre        String
  codigo        String             @unique
  numero        Int                @unique

  tipoProceso   TipoProcesoMaquina
  capacidadTon  Decimal            @db.Decimal(10,2)
  estado        EstadoMaquina      @default(ACTIVA)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // relaciones futuras: ordenes_produccion, tiempos_paro
  ordenesProduccion OrdenProduccion[]

  @@map("maquinas")
}

// ----------------------------------- CATALOGO DE OPERADORES

model Operador {
  id         BigInt   @id @default(autoincrement())
  nombre     String

  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  avancesTurno AvanceTurno[]

  @@map("operadores")
}

// ----------------------------------- CATALOGO DE MOTIVOS DE PARO

enum CategoriaMotivoParo {
  INICIO
  MATERIAL
  MOLDE
  MAQUINA
  OTROS
}


model MotivoParo {
  id        BigInt   @id @default(autoincrement())

  nombre    String   @unique
  categoria  CategoriaMotivoParo

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiemposParo TiempoParo[]

  @@map("motivos_paro")
}

// ------------------------------------  ESQUEMA DE DEFECTOS DE PRODUCTOS

model DefectoProducto {
  id         BigInt   @id @default(autoincrement())
  nombre     String   @unique

  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  avancesTurno AvanceTurno[]

  @@map("defectos_producto")
}

// ------------------------------------  ESQUEMA DE PEDIDOS

model PedidoDetalle {
  id          BigInt   @id @default(autoincrement())

  pedidoId    BigInt
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])

  productoId  BigInt
  producto    Producto @relation(fields: [productoId], references: [id])

  pigmentoId  BigInt?
  pigmento    Pigmento? @relation(fields: [pigmentoId], references: [id])
  // opcional: el cliente podría pedir "500 jarras" sin especificar color todavía,
  // o si ya lo especifica, aquí queda registrado

  cantidadSolicitada Int
  cantidadProducida  Int      @default(0)
  cantidadEntregada  Int      @default(0)

  createdAt   DateTime @default(now())

  ordenes    OrdenProduccion[]

  @@map("pedido_detalle")
}

model Pedido {
  id              BigInt       @id @default(autoincrement())

  numeroPedido    String       @unique
  cliente         String
  remision        String?
  descripcion     String?      // notas generales, ya no el detalle de productos

  estado          EstadoPedido @default(PENDIENTE)
  fechaEntrega DateTime? @db.Date 

  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  detalle         PedidoDetalle[]

  @@map("pedidos")
}

enum EstadoPedido {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

// ------------------------------------ ESQUEMA DE ORDENES DE ordenes_produccion

enum EstadoOrdenProduccion {
  BORRADOR
  ACTIVA
  EN_PROGRESO
  PAUSADA
  COMPLETADA
  CANCELADA
}

enum TipoMaterialOrden {
  VIRGEN
  MEZCLA_MOLIDO_INTERNO
  MEZCLA_RECICLADO
}

model OrdenProduccion {
  id       BigInt   @id @default(autoincrement())
  folio    String   @unique
  estado   EstadoOrdenProduccion @default(BORRADOR)

  productoId BigInt
  producto   Producto @relation(fields: [productoId], references: [id])

  totalPiezas    Int
  observaciones  String?

  tipoMaterial TipoMaterialOrden

  // pedidoDetalle relaciona explicitamente una orden con una linea de detalle de un pedido
  pedidoDetalleId BigInt
  pedidoDetalle   PedidoDetalle @relation(fields: [pedidoDetalleId], references: [id])

  // Material virgen — siempre presente, incluso en mezcla
  materiaPrimaId BigInt
  materiaPrima   MateriaPrima @relation("OrdenMateriaPrimaVirgen", fields: [materiaPrimaId], references: [id])

  // Molido — solo aplica si tipoMaterial = MEZCLA_MOLIDO_INTERNO o MEZCLA_RECICLADO
  // Referencia directa a la fila de InventarioMolido (ya identifica material+origen+color)
  inventarioMolidoId BigInt?
  inventarioMolido   InventarioMolido? @relation(fields: [inventarioMolidoId], references: [id])

  porcentajeVirgen Decimal @db.Decimal(5,2) @default(100)
  porcentajeMolido Decimal @db.Decimal(5,2) @default(0)

  pigmentoId BigInt
  pigmento   Pigmento @relation(fields: [pigmentoId], references: [id])

  aditivoDescripcion String?

  maquinaId BigInt
  maquina   Maquina @relation(fields: [maquinaId], references: [id])

  // Snapshots calculados al crear la orden — nunca se recalculan después
  piezasPorHora        Int
  piezasPorTurno       Int
  piezasPorDia         Int
  tiempoEstimadoHrs    Decimal @db.Decimal(10,2)
  materiaPrimaTotalKg  Decimal @db.Decimal(10,3)
  materiaPrimaVirgenKg Decimal @db.Decimal(10,3)
  materialMolidoKg     Decimal @db.Decimal(10,3) @default(0)
  pigmentoRequeridoKg  Decimal @db.Decimal(10,3)

  materialSiguienteConfirmado Boolean   @default(false)
  materialConfirmadoEn        DateTime?

  // columnas opcionales pero que se llenan cuando se usa materialPigmentado en una orden
  combinacionMaterialPigmentadoUsadaId BigInt?
  combinacionMaterialPigmentadoUsada   CombinacionMaterialPigmentado? @relation("OrdenMaterialPigmentadoUsado", fields: [combinacionMaterialPigmentadoUsadaId], references: [id])
  materialPigmentadoUsadoKg            Decimal? @db.Decimal(10,3)

  // Snapshot final cuando la orden llega a COMPLETADA o CANCELADA, guardamos los valores totales reales
  totalPiezasBuenasFinal      Int?
  totalPiezasDefectuosasFinal Int?
  totalKgMermaFinal           Decimal? @db.Decimal(10,3)
  totalKgPlastaFinal          Decimal? @db.Decimal(10,3)
  totalKgMaterialUsadoFinal   Decimal? @db.Decimal(10,3)

  usuarioCreadorId BigInt
  usuarioCreador   Usuario @relation("OrdenCreadaPor", fields: [usuarioCreadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avancesTurno AvanceTurno[]

  @@map("ordenes_produccion")
}


// -------------------------------------- TIEMPO PARO / SOLICITUD MATERIAL Y AVANCES DE TURNO

enum TurnoTrabajo {
  MANANA
  TARDE
  NOCHE
}

enum EstadoAvanceTurno {
  ABIERTO
  CERRADO
}

enum TipoMaterialSolicitud {
  VIRGEN
  MOLIDO
}

model AvanceTurno {
  id            BigInt   @id @default(autoincrement())

  ordenId       BigInt
  orden         OrdenProduccion @relation(fields: [ordenId], references: [id])

  supervisorId  BigInt
  supervisor    Usuario  @relation("AvanceTurnoSupervisor", fields: [supervisorId], references: [id])

  turno         TurnoTrabajo
  fecha         DateTime @db.Date
  horaInicio    DateTime
  horaFin       DateTime?

  estado            EstadoAvanceTurno @default(ABIERTO)
  borradorGuardado  Boolean           @default(false)

  piezasBuenas       Int     @default(0)
  piezasDefectuosas  Int     @default(0)

  defectoProductoId    BigInt?
  defectoProducto      DefectoProducto?    @relation(fields: [defectoProductoId], references: [id])
  descripcionOtro      String?

  operadorId       BigInt?
  operador         Operador?        @relation(fields: [operadorId], references: [id])

  cicloReal        Int?    // segundos, manual
  materialKG       Decimal? @db.Decimal(10,3) // manual, informativo

  kgMerma            Decimal @db.Decimal(10,3) @default(0)
  kgPlasta           Decimal @db.Decimal(10,3) @default(0)
  piezasCambioColor  Int     @default(0)

  // Solo se llena si el supervisor reporta sobrante explícitamente en el form.
  // NULL = no hubo sobrante (implícito, nada que confirmar).
  kgSobrante              Decimal?  @db.Decimal(10,3)
  tipoMaterialSobrante    TipoMaterialSolicitud?
  sobranteConfirmado      Boolean   @default(false)
  sobranteConfirmadoPorId BigInt?
  sobranteConfirmadoPor   Usuario?  @relation("SobranteConfirmadoPor", fields: [sobranteConfirmadoPorId], references: [id])
  sobranteConfirmadoEn    DateTime?

  // Confirmación del encargado de molino
  confirmacionMolinoConfirmado    Boolean?
  kgMermaRecibida                 Decimal? @db.Decimal(10,3)
  kgPlastaRecibida                Decimal? @db.Decimal(10,3)
  piezasMalasRecibidas            Int?
  piezasCambioColorRecibidas      Int?
  confirmacionMolinoHayDiferencia Boolean?
  confirmacionMolinoPorId         BigInt?
  confirmacionMolinoPor           Usuario? @relation("ConfirmacionMolino", fields: [confirmacionMolinoPorId], references: [id])
  confirmacionMolinoEn            DateTime?

  observaciones String?

  tiemposParo         TiempoParo[]
  solicitudesMaterial SolicitudMaterial[]
  incidenciasMalPigmentado IncidenciaMaterialMalPigmentado[]
  moliendas           MoliendaAvanceTurno[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("avances_turno")
}

model TiempoParo {
  id             BigInt   @id @default(autoincrement())

  avanceTurnoId  BigInt
  avanceTurno    AvanceTurno @relation(fields: [avanceTurnoId], references: [id])

  motivoParoId   BigInt
  motivoParo     MotivoParo  @relation(fields: [motivoParoId], references: [id])

  minutos        Int
  observaciones  String?

  createdAt      DateTime @default(now())

  @@map("tiempos_paro")
}

model SolicitudMaterial {
  id             BigInt   @id @default(autoincrement())

  avanceTurnoId  BigInt
  avanceTurno    AvanceTurno @relation(fields: [avanceTurnoId], references: [id])

  tipoMaterial   TipoMaterialSolicitud 

  kgSolicitados  Decimal  @db.Decimal(10,3)
  motivo         String

  confirmado     Boolean  @default(false)
  confirmadoPorId  BigInt?
  confirmadoPor    Usuario?  @relation("SolicitudMaterialConfirmadoPor", fields: [confirmadoPorId], references: [id])
  confirmadoEn   DateTime?

  createdAt      DateTime @default(now())

  @@map("solicitudes_material")
}

// ================================= MOLIENDAS =============================

enum DestinoPiezasMalPigmentadas {
  STOCK
  MOLINO
}

model IncidenciaMaterialMalPigmentado {
  id             BigInt   @id @default(autoincrement())

  avanceTurnoId  BigInt
  avanceTurno    AvanceTurno @relation(fields: [avanceTurnoId], references: [id])

  piezasAfectadas Int
  destino         DestinoPiezasMalPigmentadas

  // Confirmación de molino — solo aplica si destino = MOLINO
  confirmadoMolino       Boolean?
  piezasRecibidas        Int?       
  hayDiferenciaMolino    Boolean? 
  confirmadoMolinoPorId  BigInt?
  confirmadoMolinoPor    Usuario? @relation("IncidenciaConfirmadaMolino", fields: [confirmadoMolinoPorId], references: [id])
  confirmadoMolinoEn     DateTime?

  // Resolución de pigmentos
  resuelto          Boolean  @default(false)
  tipoMaterialAgregado TipoMaterialSolicitud?  // VIRGEN o MOLIDO — null si fue solo pigmento
  kgMaterialAgregado   Decimal? @db.Decimal(10,3)
  gramosPigmentoAgregado Decimal? @db.Decimal(10,3)
  resueltoPorId      BigInt?
  resueltoPor        Usuario? @relation("IncidenciaResueltaPor", fields: [resueltoPorId], references: [id])
  resueltoEn         DateTime?

  moliendas          MoliendaIncidencia[]

  createdAt      DateTime @default(now())

  @@map("incidencias_material_mal_pigmentado")
}

// ----------------------------------- MOLIENDAS

model Molienda {
  id              BigInt      @id @default(autoincrement())

  tipoMaterial    TipoMaterial

  colorSolidoId   BigInt
  colorSolido     ColorSolido @relation("MoliendaColor", fields: [colorSolidoId], references: [id])

  kgIngresados    Decimal     @db.Decimal(10,3)
  fecha           DateTime

  observaciones   String?

  avancesTurno    MoliendaAvanceTurno[]  // ← antes: ordenes MoliendaOrden[]
  incidencias     MoliendaIncidencia[]

  createdAt       DateTime    @default(now())

  @@map("moliendas")
}

model MoliendaAvanceTurno {
  id          BigInt   @id @default(autoincrement())

  moliendaId  BigInt
  molienda    Molienda        @relation(fields: [moliendaId], references: [id])

  avanceTurnoId  BigInt
  avanceTurno    AvanceTurno @relation(fields: [avanceTurnoId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([moliendaId, avanceTurnoId])
  @@map("moliendas_avances_turno")
}

model MoliendaIncidencia {
  id            BigInt   @id @default(autoincrement())

  moliendaId    BigInt
  molienda      Molienda @relation(fields: [moliendaId], references: [id])

  incidenciaId  BigInt
  incidencia    IncidenciaMaterialMalPigmentado @relation(fields: [incidenciaId], references: [id])

  createdAt     DateTime @default(now())

  @@unique([moliendaId, incidenciaId])
  @@map("moliendas_incidencias")
}

// ------------------------------------ REFRESH TOKEN

model RefreshToken {
  id         BigInt   @id @default(autoincrement())

  usuarioId  BigInt
  usuario    Usuario  @relation("RefreshTokensUsuario", fields: [usuarioId], references: [id])

  tokenHash  String   @unique   // nunca se guarda el token en texto plano, solo su hash
  expiraEn   DateTime
  revocado   Boolean  @default(false)

  userAgent  String?            // útil para que el usuario vea "sesiones activas" en el futuro
  ip         String?

  createdAt  DateTime @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ----------------------------------- historial_movimientos_inventario

enum TipoInventario {
  MATERIA_PRIMA
  PIGMENTO
  PRODUCTO
  MOLIDO
  MATERIAL_PIGMENTADO 
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

enum MotivoMovimientoInventario {
  ENTRADA_PROVEEDOR
  PRODUCCION
  CONSUMO_PRODUCCION
  DEVOLUCION_MATERIAL
  MOLIENDA_COMPLETADA
  PRODUCTO_DEFECTUOSO
  CAMBIO_COLOR
  MERMA_PRODUCCION
  PLASTA
  VENTA
  ENTREGA_PEDIDO
  REPIGMENTAR
  DESECHO
  AJUSTE_MANUAL
  CORRECCION_INVENTARIO
  CANCELACION_ORDEN
  SUSTITUCION_MATERIAL_PIGMENTADO
}

// Conexion a la tablas (existentes) que generan los movimientos 
enum ReferenciaMovimientoInventario {
  ORDEN_PRODUCCION
  AVANCE_TURNO
  MOLIENDA
  SOLICITUD_MATERIAL
  PEDIDO
  INCIDENCIA_MAL_PIGMENTADO
}

model HistorialMovimientoInventario {
  id                 BigInt   @id @default(autoincrement())

  tipoInventario     TipoInventario
  tipoMovimiento     TipoMovimientoInventario
  motivo             MotivoMovimientoInventario
  descripcion        String?

  // Exclusive arc: FKs reales hacia catálogo, solo el grupo correspondiente según tipoInventario
  materiaPrimaId     BigInt?
  materiaPrima       MateriaPrima? @relation("MovimientoMateriaPrimaVirgen", fields: [materiaPrimaId], references: [id])

  pigmentoId         BigInt?
  pigmento           Pigmento?     @relation(fields: [pigmentoId], references: [id])

  productoId         BigInt?
  producto           Producto?     @relation(fields: [productoId], references: [id])

  pigmentoProductoId BigInt?
  pigmentoProducto   Pigmento?     @relation("MovimientoColorProducto", fields: [pigmentoProductoId], references: [id])

  combinacionMaterialPigmentadoId BigInt?
  combinacionMaterialPigmentado   CombinacionMaterialPigmentado? @relation(fields: [combinacionMaterialPigmentadoId], references: [id])

  materialMolidoTipo     TipoMaterial?
  origenMolido     OrigenMolido?
  colorSolidoId    BigInt?
  colorSolido      ColorSolido? @relation("MovimientoColorSolido", fields: [colorSolidoId], references: [id])

  cantidadAnterior   Decimal  @db.Decimal(10,3)
  cantidadMovimiento Decimal  @db.Decimal(10,3) // con signo: + entrada, - salida
  cantidadNueva      Decimal  @db.Decimal(10,3)
  unidadMedida       UnidadMedida

  // Trazabilidad hacia el origen del movimiento — opcional: no todos los motivos tienen tabla que referenciar
  referenciaTipo     ReferenciaMovimientoInventario?
  referenciaId       BigInt?

  usuarioId          BigInt
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt          DateTime @default(now())

  @@index([tipoInventario, materiaPrimaId])
  @@index([tipoInventario, pigmentoId])
  @@index([tipoInventario, productoId])
  @@index([tipoInventario, pigmentoProductoId])
  @@index([tipoInventario, materialMolidoTipo])
  @@index([tipoInventario, combinacionMaterialPigmentadoId])
  @@index([motivo])
  @@index([referenciaTipo, referenciaId])
  @@index([createdAt])
  @@map("historial_movimientos_inventario")
}